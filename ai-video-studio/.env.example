# ---- Public site ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_BRAND_NAME=Your Brand
# Legal entity details shown in the legal pages (required by Israeli consumer law)
NEXT_PUBLIC_LEGAL_NAME=Your full legal / business name
NEXT_PUBLIC_BUSINESS_ID=Business or company ID number
NEXT_PUBLIC_CONTACT_EMAIL=support@your-domain.com
NEXT_PUBLIC_POSTAL_ADDRESS=Street, City, Israel
NEXT_PUBLIC_ACCESSIBILITY_COORDINATOR=Name, phone, email

# ---- Database (Postgres: Neon / Supabase / Vercel Postgres) ----
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- Claude (site analysis + writing the animation code) ----
ANTHROPIC_API_KEY=

# ---- Render worker: images, narration, music ----
# fal.ai, for generating photos when the customer did not upload enough
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-2-pro
# ElevenLabs, for the Hebrew narration (eleven_v4 supports Hebrew) and original music
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v4
ELEVENLABS_MUSIC_MODEL=music_v2_5
# Voice IDs. Pick voices that sound great in Hebrew in the ElevenLabs Voice Library.
ELEVENLABS_VOICE_FEMALE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_MALE=pNInz6obpgDQGcFmaJgB
# Optional: parallel browser pages per render
RENDER_CONCURRENCY=4

# ---- Paddle (payments, Merchant of Record) ----
# Card payments: keep false until Paddle is approved. Coupons work either way.
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# A product you create once in the Paddle dashboard ("AI ad video")
PADDLE_PRODUCT_ID=pro_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ---- Pricing ----
# Your profit margin on top of costs (1 = 100%)
PRICE_MARGIN=1
# Fixed fee per video in USD
PRICE_FIXED_FEE_USD=5
# Prices are shown and charged in shekels, VAT included (Israeli consumer law). Update the rate now and then.
USD_ILS_RATE=3.7
VAT_RATE=0.18
# Most free (100% coupon) orders per visitor per day
FREE_ORDERS_PER_IP_PER_DAY=3
# Optional, recommended: Cloudflare Turnstile bot check on the website scan (free at dash.cloudflare.com)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Storage for finished videos (optional but recommended: Vercel Blob) ----
BLOB_READ_WRITE_TOKEN=

# ---- Security ----
# Long random strings: openssl rand -hex 32
CRON_SECRET=
IP_HASH_SALT=
