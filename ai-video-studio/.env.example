# ---- Public site ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_BRAND_NAME=Your Brand
# Legal entity details shown in the legal pages (required by Israeli consumer law)
NEXT_PUBLIC_LEGAL_NAME=Your full legal / business name
NEXT_PUBLIC_BUSINESS_ID=Business or company ID number
NEXT_PUBLIC_CONTACT_EMAIL=support@your-domain.com
NEXT_PUBLIC_POSTAL_ADDRESS=Street, City, Israel
NEXT_PUBLIC_ACCESSIBILITY_COORDINATOR=Name, phone, email

# ---- Database (Postgres: Neon / Supabase / Vercel Postgres) ----
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# ---- Claude (site analysis + storyboard) ----
ANTHROPIC_API_KEY=

# ---- fal.ai (video generation) ----
FAL_KEY=
# Text-to-video endpoint. Check https://fal.ai for the current model; endpoints get deprecated.
FAL_VIDEO_MODEL=fal-ai/veo3.1/fast
FAL_MERGE_MODEL=fal-ai/ffmpeg-api/merge-videos
# Your real cost per generated second on that model (USD) - check fal.ai/pricing
VIDEO_COST_PER_SECOND_USD=0.40

# ---- Paddle (payments, Merchant of Record) ----
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# A product you create once in the Paddle dashboard ("AI ad video")
PADDLE_PRODUCT_ID=pro_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ---- Pricing ----
# Your profit margin on top of costs (0.5 = 50%)
PRICE_MARGIN=0.5
# Fixed fee per video in USD
PRICE_FIXED_FEE_USD=3

# ---- Storage for finished videos (optional but recommended: Vercel Blob) ----
BLOB_READ_WRITE_TOKEN=

# ---- Security ----
# Long random strings: openssl rand -hex 32
CRON_SECRET=
IP_HASH_SALT=
